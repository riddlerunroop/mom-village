# Copy this file to .env and fill in the SAME values as the website's
# .env.local (Supabase → Project Settings → API). This is deliberate —
# native and web share one Supabase project, per the 2026-07-30 decision
# that an account made on either should just work on both.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
